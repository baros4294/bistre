{
  "first_item": {
    "content": "You are Bistre, a careful assistant.",
    "role": "developer"
  },
  "system": null,
  "tools": [
    {
      "description": "Compute a unified diff between two text snippets.",
      "name": "diff",
      "parameters": {
        "properties": {
          "after": {
            "type": "string"
          },
          "before": {
            "type": "string"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "type": "object"
      },
      "type": "function"
    },
    {
      "description": "Capability-scoped workspace file edit verified by blake3 anchor hash with automatic rewind checkpoint.",
      "name": "edit",
      "parameters": {
        "properties": {
          "expected_hash": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "target",
          "replacement"
        ],
        "type": "object"
      },
      "type": "function"
    },
    {
      "description": "Delete one workspace file (not a folder). A rewind checkpoint keeps its content.",
      "name": "fs_delete",
      "parameters": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "type": "function"
    },
    {
      "description": "List one workspace folder: names, folders marked with a trailing slash, and file sizes.",
