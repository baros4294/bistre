            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "function"
    },
    {
      "description": "Move or rename one workspace file. Never replaces an existing file.",
      "name": "fs_move",
      "parameters": {
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "type": "function"
    },
    {
      "description": "Apply several exact text replacements to one workspace file in order; all apply or none do.",
