              "type": "object"
            },
            "type": "array"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "edits"
        ],
        "type": "object"
      },
      "type": "function"
    },
    {
      "description": "Create a workspace file, or replace a whole file you have read in full. Creates missing folders.",
