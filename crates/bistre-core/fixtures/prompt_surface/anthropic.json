{
  "first_item": null,
  "system": [
    {
      "cache_control": {
        "type": "ephemeral"
      },
      "text": "You are Bistre, a careful assistant.",
      "type": "text"
    }
  ],
  "tools": [
    {
      "description": "Compute a unified diff between two text snippets.",
      "input_schema": {
        "properties": {
          "after": {
            "type": "string"
          },
          "before": {
            "type": "string"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "type": "object"
      },
      "name": "diff"
    },
    {
      "description": "Capability-scoped workspace file edit verified by blake3 anchor hash with automatic rewind checkpoint.",
      "input_schema": {
        "properties": {
          "expected_hash": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "target",
          "replacement"
        ],
        "type": "object"
      },
      "name": "edit"
    },
    {
      "description": "Delete one workspace file (not a folder). A rewind checkpoint keeps its content.",
      "input_schema": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "fs_delete"
    },
    {
      "description": "List one workspace folder: names, folders marked with a trailing slash, and file sizes.",
      "input_schema": {
        "properties": {
          "path": {
            "description": "Folder relative to the workspace; empty for the top.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "fs_list"
    },
    {
      "description": "Move or rename one workspace file. Never replaces an existing file.",
      "input_schema": {
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "name": "fs_move"
    },
    {
      "description": "Apply several exact text replacements to one workspace file in order; all apply or none do.",
      "input_schema": {
        "properties": {
          "edits": {
            "items": {
              "properties": {
                "replacement": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                }
              },
              "required": [
                "target",
                "replacement"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "edits"
        ],
        "type": "object"
      },
      "name": "fs_multi_edit"
    },
    {
      "description": "Create a workspace file, or replace a whole file you have read in full. Creates missing folders.",
      "input_schema": {
        "properties": {
          "content": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      },
      "name": "fs_write"
    },
    {
      "description": "Find workspace files matching a glob pattern respecting .gitignore.",
      "input_schema": {
        "properties": {
          "pattern": {
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "name": "glob"
    },
    {
      "description": "Search workspace text files using ripgrep regex engine respecting .gitignore.",
      "input_schema": {
        "properties": {
          "pattern": {
            "type": "string"
          },
          "subpath": {
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "name": "grep"
    },
    {
      "description": "Read a workspace UTF-8 file with line numbers and blake3 line-hash anchors.",
      "input_schema": {
        "properties": {
          "end_line": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": "integer"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "name": "read"
    },
    {
      "description": "Run a bounded shell command inside the bound workspace directory.",
      "input_schema": {
        "properties": {
          "command": {
            "type": "string"
          },
          "timeout_secs": {
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "name": "shell"
    },
    {
      "description": "Fetch a public HTTP/HTTPS URL and extract clean readable text.",
      "input_schema": {
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "name": "web_fetch"
    },
    {
      "cache_control": {
        "type": "ephemeral"
      },
      "description": "Search the public web for up-to-date information and return ranked results with titles, URLs, and snippets.",
      "input_schema": {
        "properties": {
          "max_results": {
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "web_search"
    }
  ]
}
